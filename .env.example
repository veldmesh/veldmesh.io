NEXT_PUBLIC_APP_URL=https://app.veldmesh.io

# Waitlist sinks — the /api/waitlist route forwards each signup to every
# sink whose variables are set. The browser never talks to a third party;
# only this route does. Never commit real values; set them in the
# environment (Vercel project settings, systemd Environment=, etc.).
#
# Sink 1: webhook (any endpoint accepting the documented payload)
# WAITLIST_WEBHOOK_URL=https://mission-control.example/api/waitlist
# WAITLIST_WEBHOOK_TOKEN=shared-secret-sent-as-bearer-token
#
# Sink 2: email notification to the owner's inbox
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# WAITLIST_NOTIFY_TO=owner@veldmesh.io
