# Application
NEXT_PUBLIC_APP_URL=https://app.veldmesh.io

# Waitlist API - operator's server, reached over the Veld mesh
WAITLIST_FORWARD_URL=https://example.com/api/waitlist
WAITLIST_BEARER_TOKEN=your-bearer-token-here

# Queue Encryption (age)
# Generate a key pair with: age-keygen
# The web server holds ONLY the age PUBLIC key (starts with 'age1...').
# The matching private key lives on the operator's server, which decrypts
# queued entries there. Never put a private key on this host.
QUEUE_ENCRYPTION_KEY=age1...

# Logging
# Salt for email hashing in logs (required in production)
LOG_SALT=your-random-salt-here

# Queue Storage
WAITLIST_QUEUE_DIR=/var/lib/veldsite/waitlist-queue

# Optional: Queue Limits
# MAX_QUEUE_FILES=10000
# MAX_QUEUE_SIZE_MB=100
