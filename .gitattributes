# Normalize line endings to LF on commit (cross-platform consistency)
* text=auto eol=lf

# Explicitly text files
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.env   text eol=lf
*.lock  text eol=lf -diff

# Binary files — no line-ending conversion, no diffing
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.svg   text eol=lf

# Linguist overrides (GitHub language stats)
package-lock.json linguist-generated=true
*.lock            linguist-generated=true
