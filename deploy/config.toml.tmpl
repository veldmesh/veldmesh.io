# Veld daemon configuration (static mode)
# Rendered from template by GitHub Actions workflow

[peer]
# Ironserver mesh IP and public endpoint
mesh_ip = "${IRONSERVER_MESH_IP}"
public_endpoint = "${IRONSERVER_PUBLIC_ENDPOINT}"

[local]
# This VM's mesh IP and public endpoint
mesh_ip = "${VM_MESH_IP}"
public_endpoint = "${VM_PUBLIC_ENDPOINT}"
# Mesh port for WireGuard/vel communication
mesh_port = ${VM_MESH_PORT}

[network]
# Network interface for mesh traffic
interface = "velmesh"

[logging]
level = "info"
format = "json"
