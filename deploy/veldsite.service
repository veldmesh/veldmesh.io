[Unit]
Description=Veldsite Next.js Application
After=network.target
Wants=network.target

[Service]
Type=simple
User=velsite
Group=velsite
WorkingDirectory=/opt/veldsite/app
ExecStart=/opt/veldsite/app/server.js
EnvironmentFile=/opt/veldsite/.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=veldsite

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/veldsite/app

[Install]
WantedBy=multi-user.target