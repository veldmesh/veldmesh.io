[Unit]
Description=Veld Mesh Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=vel
Group=vel
ExecStart=/usr/local/bin/vel-daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vel-daemon

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
StandardInput=null

# Network capabilities for mesh (WireGuard)
# CAP_NET_ADMIN required for WireGuard interface management
# CAP_NET_RAW required for raw socket operations
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Allow access to config directory
ReadWritePaths=/etc/vel
ReadWritePaths=/etc/velmesh

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
